+    /// frankentorch-md74s: the grad-path forward now hands ONE argmax allocation to
+    /// both its backward closure and the sum-shortcut registry, instead of cloning it
+    /// and calling `save_for_backward`. That rewires which object each backward reads,
+    /// so both routes are exercised here against a hand-computed expectation.
+    ///
+    /// The two routes are selected by the LOSS, not by a flag: `sum(pool(x))` fires the
+    /// scalar shortcut, `sum(pool(x) * pool(x))` does not and takes the dense backward
+    /// (NEGATIVE_EVIDENCE item 37). A test that only summed would leave the dense route
+    /// unexercised, which is exactly the blind spot that item records.
+    #[test]
+    fn max_pool1d_shared_argmax_sidecar_feeds_both_backward_routes() {
+        // Distinct values so every window has a unique maximum and the expected
+        // gradient is unambiguous.
+        let values: Vec<f64> = (0..2 * 3 * 8)
+            .map(|index| ((index * 37 + 11) % 97) as f64 * 0.125 - 6.0)
+            .collect();
+        let shape = vec![2usize, 3, 8];
+
+        // ---- route 1: sum(pool(x)) -> the scalar sum shortcut ----
+        let mut sess = FrankenTorchSession::new(ExecutionMode::Strict);
+        let x = sess.tensor_variable(values.clone(), shape.clone(), true).unwrap();
+        let pooled = sess.functional_max_pool1d(x, 2, 2).unwrap();
+        let loss = sess.tensor_sum(pooled).unwrap();
+        let report = sess.tensor_backward(loss).unwrap();
+        let grad_shortcut = sess.tensor_gradient(&report, x).expect("shortcut input grad");
+
+        // ---- route 2: sum(pool(x)^2) -> the dense backward ----
+        let mut sess_sq = FrankenTorchSession::new(ExecutionMode::Strict);
+        let x_sq = sess_sq.tensor_variable(values.clone(), shape.clone(), true).unwrap();
+        let pooled_sq = sess_sq.functional_max_pool1d(x_sq, 2, 2).unwrap();
+        let squared = sess_sq.tensor_mul(pooled_sq, pooled_sq).unwrap();
+        let loss_sq = sess_sq.tensor_sum(squared).unwrap();
+        let pooled_values = sess_sq.tensor_values(pooled_sq).unwrap();
+        let report_sq = sess_sq.tensor_backward(loss_sq).unwrap();
+        let grad_dense = sess_sq.tensor_gradient(&report_sq, x_sq).expect("dense input grad");
+
+        // Expected: gradient lands on each window's argmax, 1.0 for the sum loss and
+        // 2*max for the squared loss; everything else is zero.
+        let (planes, len, out_len) = (2 * 3usize, 8usize, 4usize);
+        let mut want_shortcut = vec![0.0f64; planes * len];
+        let mut want_dense = vec![0.0f64; planes * len];
+        for plane in 0..planes {
+            for ox in 0..out_len {
+                let a = plane * len + ox * 2;
+                let b = a + 1;
+                let arg = if values[b] > values[a] { b } else { a };
+                want_shortcut[arg] = 1.0;
+                want_dense[arg] = 2.0 * pooled_values[plane * out_len + ox];
+            }
+        }
+
+        for i in 0..planes * len {
+            assert_eq!(
+                grad_shortcut[i].to_bits(),
+                want_shortcut[i].to_bits(),
+                "md74s shortcut-route grad at {i}: got {} want {}",
+                grad_shortcut[i],
+                want_shortcut[i]
+            );
+            assert_eq!(
+                grad_dense[i].to_bits(),
+                want_dense[i].to_bits(),
+                "md74s dense-route grad at {i}: got {} want {}",
+                grad_dense[i],
+                want_dense[i]
+            );
+        }
+    }
+
