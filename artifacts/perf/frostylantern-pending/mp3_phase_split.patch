+            total_ns = total_ns.min(t.elapsed().as_nanos());
+            std::hint::black_box(drain(&din));
+            ft_core::buffer_pool::recycle(din);
+        }
+
+        let scatter_ns = total_ns.saturating_sub(zero_ns);
+        #[allow(clippy::cast_precision_loss)]
+        let pct = (zero_ns as f64) * 100.0 / (total_ns.max(1) as f64);
+        println!(
+            "max_pool3d backward phase split, shape [{batch},{ch},{id},{ih},{iw}], \
+             {in_numel} elems in / {out_numel} out, min of 9:\n  \
+             take_zeroed        {zero_ns:>10} ns  ({pct:.1}% of total)\n  \
+             scatter (residual) {scatter_ns:>10} ns\n  \
+             whole backward     {total_ns:>10} ns"
+        );
+
+        // Not an assertion about which phase wins -- that is the measurement. The only
+        // invariant is that the parts cannot exceed the whole by more than noise.
+        assert!(
+            zero_ns <= total_ns * 2,
+            "zeroing arm {zero_ns} ns wildly exceeds the whole backward {total_ns} ns; \
+             the two arms are not measuring the same thing"
+        );
+    }
