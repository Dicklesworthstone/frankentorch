     /// vs-PyTorch row. It answers one question: does replacing zero-then-scatter
     /// with a single full-coverage pass pay, given that `NEGATIVE_EVIDENCE` item 3
     /// measured that trade going the WRONG way on pooling backwards?
+    /// frankentorch-3ja43 / NEGATIVE_EVIDENCE item 42: SPLIT the max_pool3d backward
+    /// into its zeroing and its scatter, at the h2h lane's shape, because two attempts
+    /// to price those phases by arithmetic both failed.
+    ///
+    /// Attempt one assumed a DRAM memset (~10 GB/s) and concluded the backward was ~100%
+    /// zeroing. Attempt two measured `zero_()` in a tight loop, got 0.026 ms, and
+    /// concluded the zeroing was ~3%. Both are proxies: the tight loop keeps 8 MiB inside
+    /// this box's 128 MiB L3, while the live path writes the buffer once and hands it to
+    /// a consumer that streams it. Neither number describes the kernel.
+    ///
+    /// So this measures the kernel. The zeroing arm CONSUMES its buffer with a strided
+    /// read and recycles it, so the pool churns the way it does in the lane instead of
+    /// handing back one perpetually-hot allocation.
+    #[test]
+    fn max_pool3d_backward_phase_split_zeroing_versus_scatter() {
+        // The h2h lane's shape exactly: 1_048_576 f64 in, 131_072 out, 12.5% density.
+        let (batch, ch, id, ih, iw) = (2usize, 32usize, 16usize, 32usize, 32usize);
+        let (od, oh, ow) = (id / 2, ih / 2, iw / 2);
+        let in_numel = batch * ch * id * ih * iw;
+        let out_numel = batch * ch * od * oh * ow;
+
+        let mut z = 0x2468_ace0_1357_9bdfu64;
+        let input: Vec<f64> = (0..in_numel)
+            .map(|_| {
+                z ^= z << 13;
+                z ^= z >> 7;
+                z ^= z << 17;
+                #[allow(clippy::cast_precision_loss)]
+                let v = ((z >> 40) as f64) / 512.0 - 2.0;
+                v
+            })
+            .collect();
+        let (_, offsets) = super::max_pool3d_forward_with_indices_f64(
+            &input, batch, ch, id, ih, iw, 2, 2, 2, od, oh, ow, 2, 2, 2,
+        );
+        #[allow(clippy::cast_precision_loss)]
+        let dout: Vec<f64> = (0..out_numel).map(|i| (i % 13) as f64 - 6.0).collect();
+
+        // Consume a buffer the way the lane's consumer does, so the timing that follows
+        // does not inherit a buffer that is still hot from the arm before it.
+        fn drain(buf: &[f64]) -> f64 {
+            let mut acc = 0.0f64;
+            let mut i = 0usize;
+            while i < buf.len() {
+                acc += buf[i];
+                i += 512; // one touch per 4 KiB page
+            }
+            acc
+        }
+
+        let (mut zero_ns, mut total_ns) = (u128::MAX, u128::MAX);
+        for _ in 0..9 {
+            // ARM A: allocation + zeroing only, the first half of the backward.
+            let t = std::time::Instant::now();
+            let zeroed = ft_core::buffer_pool::take_zeroed(in_numel);
+            zero_ns = zero_ns.min(t.elapsed().as_nanos());
+            std::hint::black_box(drain(&zeroed));
+            ft_core::buffer_pool::recycle(zeroed);
+
+            // ARM B: the whole backward, zeroing and scatter together.
+            let t = std::time::Instant::now();
+            let din = super::max_pool3d_backward_from_indices_nonoverlapping_f64(
+                &dout, &offsets, batch, ch, id, ih, iw, od, oh, ow,
