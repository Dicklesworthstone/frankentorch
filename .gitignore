# Beads ephemeral DB artifacts (bad/rebuild/vacuum snapshots)
.beads/beads.db.bad_*
.beads/beads.db.rebuild_*
.beads/beads.db.vacuum_*
.beads/beads.db.rebuild_c*
.beads/beads.db.vacuum_c*

# Beads recovery snapshots taken before a repair attempt. Kept on disk
# deliberately (they are the rollback path) but never committed: each is a
# full copy of the 15 MB DB family plus the 2 MB JSONL.
.beads/*.corrupt_*
.beads/recovery_2026*/

# br's fsqlite-ns VFS sidecars — per-machine runtime state, like the -wal/-shm
# files. br reads the DB *through* this layer, so these are not optional
# scratch, but they are local-only and must not be committed.
.beads/beads.db-fsqlite-ns-*
.beads/*.db-wal-cert*

# Beads recovery scratch databases and probe directories
artifacts/beads_recovery/
.env
.claude/settings.local.json

# Ephemeral agent/skill scratch (repo-janitor 2026-06-04)
.skill-loop-progress.md
.skill-loop-progress-*.md
*.mcp.json

# Perf `perf record` dumps + rotated snapshots. The per-run
# artifacts/perf/frankentorch-*/ dirs are curated/tracked (logs, .md, sha256),
# but the raw multi-MB perf .data binaries and their .old rotations are not.
artifacts/perf/**/*.data
artifacts/perf/**/*.data.old
# Ad-hoc compiled probe binary that lands at the repo root (e.g. building a
# probe example without --target-dir); a ~4MB ELF, never a tracked artifact.
/probe
# br doctor per-run artifacts
.doctor/

# === Ephemeral build & scratch artifacts (multi-repo cleanup 2026-06-18) ===
# Stray out-of-tree compile outputs (normal builds live under target/, already ignored).
*.rlib
rust_out
# One-off local CARGO_TARGET_DIR override directories (e.g. criterion micro-benches).
**/local-target/
