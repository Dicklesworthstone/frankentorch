#!/bin/sh
# FrankenTorch pre-commit hook: UBS security scanner with large-file handling
#
# Uses --staged mode for efficiency. For files >50K lines (like ft-api/src/lib.rs),
# runs with extended timeout or warns if timeout would occur.

set -e

# --- parsing helpers, shared by the gate and by --self-test ------------------
# Defined once so the self-test exercises the SAME code the gate runs. A test
# that reimplements the parser proves only that the test agrees with itself.

# Number on the last `Critical:` line, or empty if ubs printed none.
ubs_critical_count() {
    printf '%s\n' "$1" | sed -n 's/^Critical:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | tail -1
}

# "yes" when the scanner reported it looked at zero files.
ubs_scanned_nothing() {
    case "$1" in
        *"Files: 0"*) echo yes ;;
        *) echo no ;;
    esac
}

# --- self-test: `hooks/pre-commit --self-test` -------------------------------
# frankentorch-imtpq. Runs in well under a second, needs no repo state, no ubs
# and no network, so it is runnable anywhere.
if [ "$1" = "--self-test" ]; then
    st_fail=0
    st_check() {
        if [ "$2" = "$3" ]; then
            echo "ok   $1"
        else
            echo "FAIL $1: expected [$2] got [$3]"
            st_fail=1
        fi
    }

    st_check "critical: zero parsed" "0" \
        "$(ubs_critical_count 'Files: 3
Critical: 0
Warning: 2')"
    st_check "critical: nonzero parsed" "7" \
        "$(ubs_critical_count 'Files: 3
Critical: 7
Warning: 2')"
    st_check "critical: multi-digit parsed" "12" \
        "$(ubs_critical_count 'Critical: 12')"
    # NEGATIVE: no Critical line at all must yield empty, NOT zero — "absent" and
    # "zero findings" are different claims and the gate must not conflate them.
    st_check "critical: absent is empty" "" \
        "$(ubs_critical_count 'Files: 3
Warning: 2')"
    # NEGATIVE: a Critical line that is not at line start (e.g. quoted inside a
    # finding body) must not be picked up as the summary.
    st_check "critical: indented line ignored" "" \
        "$(ubs_critical_count '    Critical: 9')"

    st_check "zero-files: detected" "yes" "$(ubs_scanned_nothing 'Files: 0
Critical: 0')"
    st_check "zero-files: nonzero not flagged" "no" "$(ubs_scanned_nothing 'Files: 7
Critical: 0')"
    # NEGATIVE: the substring must not match a larger count such as "Files: 01"
    # only by accident — 70 files is a real scan and must not read as zero.
    st_check "zero-files: 70 is not zero" "no" "$(ubs_scanned_nothing 'Files: 70')"

    if [ "$st_fail" -eq 0 ]; then
        echo "pre-commit self-test: all checks passed"
    fi
    exit "$st_fail"
fi

# Skip if UBS not installed
if ! command -v ubs >/dev/null 2>&1; then
    echo "ubs: not found, skipping security scan"
    exit 0
fi

if [ -n "$UBS_SKIP" ]; then
    echo "ubs: UBS_SKIP set, skipping security scan"
    exit 0
fi

# Check for staged Rust files
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$STAGED_RS" ]; then
    exit 0
fi

run_ubs_staged() {
    timeout_seconds=$1

    # frankentorch-imtpq: NO `--quiet`. That flag is why this gate scanned
    # nothing — it suppresses the scan itself, not just the output. Isolated in a
    # one-file throwaway repo, changing ONE variable at a time:
    #     ubs --staged --only=rust --quiet   -> "1 detected", Files: 0   <- broken
    #     ubs --staged --only=rust           -> "1 detected", Files: 1   <- scans
    #     ubs --only=rust <path> --quiet     -> Files: 0                 <- broken
    #     ubs --only=rust <path>             -> Files: 1                 <- scans
    # `--staged` is fine; `--quiet` is the bug, on both invocation shapes.
    #
    # `--staged` is preferred: it scans the staged BLOB, which is what a
    # pre-commit gate should judge. Passing explicit paths scans the working tree
    # instead, so a file with unstaged edits would be judged in the wrong form.
    #
    # BUT ubs cannot scan the huge files in this repo. Measured with the fixed
    # invocation: crates/ft-api/src/lib.rs (167k lines) does not finish in 90s.
    # `--staged` is all-or-nothing, so one huge staged file would time the WHOLE
    # scan out and nothing would be examined. When a huge file is staged we
    # therefore fall back to explicit paths for the scannable ones and say plainly
    # which files were skipped — coverage that is bounded must be logged, not
    # silently truncated.
    set +e
    if [ -n "$UNSCANNABLE_RS" ]; then
        echo "ubs: NOT SCANNED (too large for ubs, see frankentorch-imtpq):$UNSCANNABLE_RS"
        if [ -z "$SCANNABLE_RS" ]; then
            echo "ubs: every staged Rust file is too large to scan; nothing was examined."
            set -e
            return 0
        fi
        echo "ubs: scanning the remaining staged file(s) by path (worktree content)."
        # shellcheck disable=SC2086 # deliberate word-split path list
        UBS_OUTPUT=$(timeout "$timeout_seconds" ubs --only=rust $SCANNABLE_RS 2>&1)
    else
        UBS_OUTPUT=$(timeout "$timeout_seconds" ubs --staged --only=rust 2>&1)
    fi
    code=$?
    set -e

    if [ -n "$UBS_OUTPUT" ]; then
        printf '%s\n' "$UBS_OUTPUT"
    fi

    if [ "$code" -eq 0 ]; then
        # frankentorch-imtpq: exit 0 is NOT evidence the scanner looked at
        # anything. ubs prepares a shadow workspace from the staged files and can
        # report "Files: 0" while still exiting 0 — which turns this gate into a
        # no-op that reads as a pass. Observed on every commit of a 2026-08-08
        # session, including one staging crates/ft-kernel-cpu/src/lib.rs, where
        # the hook printed "large file(s) staged" and ubs then scanned 0 files.
        #
        # So check the POSITIVE evidence (a file count) rather than trusting the
        # status alone, exactly as that bead argues: "prefer POSITIVE execution
        # evidence over exit codes where it exists".
        # ubs exits 0 even WITH findings unless --fail-on-warning, so the status
        # is weak evidence on its own. Read the Critical line, which AGENTS.md
        # classes as always-fix (memory safety, races, injection).
        critical=$(ubs_critical_count "$UBS_OUTPUT")
        if [ -n "$critical" ] && [ "$critical" -gt 0 ]; then
            echo "ubs: $critical CRITICAL finding(s) in staged Rust - failing the commit."
            echo "ubs: these are the always-fix class; if it is a false positive, UBS_SKIP=1."
            return 1
        fi

        case "$(ubs_scanned_nothing "$UBS_OUTPUT")" in
            yes)
                echo "ubs: WARNING - exited 0 but reported 'Files: 0' while Rust files were staged."
                echo "ubs: this commit was NOT scanned. The gate passed on an exit code, not on evidence."
                echo "ubs: staged:$STAGED_RS"
                echo "ubs: see frankentorch-imtpq. Set UBS_REQUIRE_SCAN=1 to make this FAIL the commit."
                if [ -n "$UBS_REQUIRE_SCAN" ]; then
                    echo "ubs: UBS_REQUIRE_SCAN set - failing the commit."
                    return 1
                fi
                ;;
        esac
        return 0
    fi

    if [ "$code" -eq 124 ]; then
        return 124
    fi

    case "$UBS_OUTPUT" in
        *"Files: 0"*Critical:*0*Warning:*0*Info:*0*)
            echo "ubs: staged scan reported zero files and zero findings; treating as pass"
            return 0
            ;;
    esac

    return "$code"
}

# Split the staged Rust files into what ubs can and cannot scan.
#
# frankentorch-imtpq: this threshold is not cosmetic. Measured with the FIXED
# (non---quiet) invocation, crates/ft-api/src/lib.rs at 167k lines does not finish
# in 90s. Before the fix this never mattered, because the scan examined nothing
# and returned instantly; now that it genuinely scans, a huge staged file would
# hang the gate and — under the old timeout branch — FAIL the commit. That would
# make the repo's largest crate uncommittable, so the huge files are separated out
# and named rather than allowed to sink the whole scan.
LARGE_FILE_THRESHOLD=50000
SCANNABLE_RS=""
UNSCANNABLE_RS=""

for f in $STAGED_RS; do
    if [ -f "$f" ]; then
        lines=$(wc -l < "$f")
        if [ "$lines" -gt "$LARGE_FILE_THRESHOLD" ]; then
            UNSCANNABLE_RS="$UNSCANNABLE_RS $f"
        else
            SCANNABLE_RS="$SCANNABLE_RS $f"
        fi
    fi
done

if [ -n "$UNSCANNABLE_RS" ]; then
    # Extended timeout; the huge files are excluded inside run_ubs_staged.
    run_ubs_staged 300 || {
        code=$?
        if [ "$code" -eq 124 ]; then
            echo ""
            echo "ubs: TIMED OUT - these staged files were NOT scanned:$SCANNABLE_RS"
            echo "ubs: passing anyway. A timeout means the gate does not KNOW, and"
            echo "ubs: blocking on 'do not know' would halt every commit in this repo."
            echo "ubs: scan manually if this change touches anything security-relevant."
            exit 0
        fi
        exit $code
    }
else
    # Standard 120s timeout for normal files
    run_ubs_staged 120 || {
        code=$?
        if [ "$code" -eq 124 ]; then
            echo "ubs: TIMED OUT on files all under $LARGE_FILE_THRESHOLD lines - unexpected."
            echo "ubs: passing, for the same reason as the large-file branch: a timeout is"
            echo "ubs: 'do not know', and this gate must not halt the repo on that. Worth"
            echo "ubs: reporting if it recurs, because it should not happen at this size."
            exit 0
        fi
        exit $code
    }
fi
